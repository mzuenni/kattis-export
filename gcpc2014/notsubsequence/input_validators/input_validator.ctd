INT(1, 100, t) NEWLINE
REP(t)
	INT(1, 62, k) SPACE
	REGEX(chars[k], s) NEWLINE
	ASSERT(1 <= STRLEN(s) && STRLEN(s) <= 10^6)

END
EOF
